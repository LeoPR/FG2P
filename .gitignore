# === DICTS-WORKBENCH (v2) ===
# Pipeline declarativo de normalizacao multi-idioma.
# Os .rules.tsv, scripts, README e .gitmodules sao versionados.
# As fontes (ipa-dict) vem como submodulo git formal — git cuida.
# Apenas o output gerado pelo pipeline nao e versionado.

# Output gerado pelo pipeline normalize_dicts.py
# Pode ser regenerado: python dicts-workbench/scripts/normalize_dicts.py --group <id>
dicts-workbench/output/

# === PUBLICATION DRAFTS ===
# Os .tex, .bib e .md sao versionados normalmente.
# Double-blind: pesquisado — preprints publicos nao impedem avaliacao
# (avaliadores podem descobrir autoria, nao e proibitivo).
# Somente artefatos de compilacao sao ignorados abaixo.

# === LaTeX BUILD ARTIFACTS ===
# Artefatos intermediarios gerados pelo compilador LaTeX (latexmk/pdflatex)
# Aplica-se a qualquer subpasta dentro de publications/
docs/article/publications/**/*.aux
docs/article/publications/**/*.bbl
docs/article/publications/**/*.blg
docs/article/publications/**/*.fdb_latexmk
docs/article/publications/**/*.fls
docs/article/publications/**/*.log
docs/article/publications/**/*.pdf
docs/article/publications/**/*.synctex.gz
docs/article/publications/**/*.synctex
docs/article/publications/**/*.out
docs/article/publications/**/*.toc
docs/article/publications/**/.build/

# === LARGE BINARIES & ARCHIVES ===
# Model checkpoints — only active alias checkpoints tracked
# best_per  → exp104d_structural_tokens_correct
# best_wer  → exp9_intermediate_distance_aware (both checkpoints for history)
# All others (exp104b, exp104c, exp107, etc.) ignored to keep repo small
models/*/*.pt
!models/exp104d_structural_tokens_correct/*.pt
!models/exp9_intermediate_distance_aware/*.pt
!models/exp205_en_us_baseline/*.pt
FG2P.7z
docs/*.pdf

# === LARGE GENERATED RESULT FILES ===
# Prediction TSVs: ~28k words per experiment, not useful without code to analyze
results/predictions_*.tsv
results/*/predictions_*.tsv
# Binary presentation (generated from presentation_generator.py)
results/*.pptx

# === GENERATED OUTPUTS (not source) ===
model_report.html
docs/FG2P_Consolidated_Report.html
docs/FG2P_Report.docx
docs/*.docx
docs/*.html

# === DEVELOPMENT ARTIFACTS (not for public release) ===
IACgen.md
TODO.md
docs/CODEBASE_AUDIT.md
docs/BATCH_SIZE_RECOMMENDATIONS.md
# Arquivo de aula não relacionado ao projeto
src/aula01_p1_3.py
# VSCode workspace file (local config)
*.code-workspace

# === WORKING DIRS (local only) ===
/backups
/.claude
/cache
/data
/logs
/results/_reports

# === HISTORICAL ARTIFACTS ===
CONSOLIDACAO_DOCUMENTACAO.md

