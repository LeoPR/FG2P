# === LaTeX BUILD ARTIFACTS ===
# Artefatos intermediários gerados pelo compilador LaTeX (latexmk/pdflatex)
# O PDF final (main.pdf) também é ignorado — gerado localmente pelo compilador
# Para incluir o PDF no git manualmente: git add -f docs/article/icassp/main.pdf
docs/article/icassp/*.aux
docs/article/icassp/*.bbl
docs/article/icassp/*.blg
docs/article/icassp/*.fdb_latexmk
docs/article/icassp/*.fls
docs/article/icassp/*.log
docs/article/icassp/*.pdf
docs/article/icassp/*.synctex.gz
docs/article/icassp/*.synctex
docs/article/icassp/*.out
docs/article/icassp/*.toc
# Subdiretório de build configurado no latexmkrc ($out_dir = '.build')
docs/article/icassp/.build/

# === LARGE BINARIES & ARCHIVES ===
# Model checkpoints — only active alias checkpoints tracked
# best_per  → exp104d_structural_tokens_correct
# best_wer  → exp9_intermediate_distance_aware (both checkpoints for history)
# All others (exp104b, exp104c, exp107, etc.) ignored to keep repo small
models/*/*.pt
!models/exp104d_structural_tokens_correct/*.pt
!models/exp9_intermediate_distance_aware/*.pt
FG2P.7z
docs/*.pdf

# === LARGE GENERATED RESULT FILES ===
# Prediction TSVs: ~28k words per experiment, not useful without code to analyze
results/predictions_*.tsv
results/*/predictions_*.tsv
# Raw benchmark CSVs (regenerable; large)
results/*/benchmark_*_cuda_raw*.csv
# Binary presentation (generated from presentation_generator.py)
results/*.pptx

# === GENERATED OUTPUTS (not source) ===
model_report.html
docs/FG2P_Consolidated_Report.html
docs/FG2P_Report.docx
docs/*.docx
docs/*.html

